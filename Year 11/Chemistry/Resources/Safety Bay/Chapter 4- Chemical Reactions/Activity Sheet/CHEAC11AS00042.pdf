   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">BS9188</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>ace cold pack</rdf:li>
     <rdf:li>cold pack</rdf:li>
     <rdf:li>cold compress</rdf:li>
     <rdf:li>instant cold pack</rdf:li>
     <rdf:li>instant ice</rdf:li>
     <rdf:li>icing</rdf:li>
     <rdf:li>ammonium nitrate</rdf:li>
     <rdf:li>bag</rdf:li>
     <rdf:li>still life</rdf:li>
     <rdf:li>cold</rdf:li>
     <rdf:li>compress</rdf:li>
     <rdf:li>cooling</rdf:li>
     <rdf:li>treatment</rdf:li>
     <rdf:li>ice pack</rdf:li>
     <rdf:li>instant ice pack</rdf:li>
     <rdf:li>cold therapy</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Photo Researchers, Inc.</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">(c) Photo Researchers, Inc.</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">ACE cold packs are often used to instead of ice for 'cold therapy' on injuries. An instant cold pack is made up of a bag containing water inside a second bag containing ammonium nitrate. When the inner bag is broken by squeezing the package, the ammonium nitrate dissolves in the water in an endothermic reaction. The reaction absorbs heat from the surroundings, and quickly lowers the pack's temperature.</rdf:li>
    </rdf:Alt>
   </dc:description>
